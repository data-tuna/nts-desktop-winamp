{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unofficial NTS Player",
  "mainBinaryName": "nts-desktop-winamp",
  "version": "../package.json",
  "identifier": "com.datatuna.ntswinamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unofficial NTS Player",
        "width": 275,
        "height": 348,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --enable-features=HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "data-tuna",
    "homepage": "https://github.com/data-tuna/nts-desktop-winamp",
    "copyright": "Copyright (c) 2026 Ata Tuna. Not made or endorsed by NTS.",
    "shortDescription": "Unofficial Winamp-style player for NTS Radio",
    "longDescription": "An unofficial Winamp-style desktop player for NTS Radio. Not made, endorsed or supported by NTS."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NDQ4OTU5M0ZEQUM3REIKUldUYng5by9XWWxFZG5xZnNRRzR5RWs1TU9Sd0FDcmcvejV6dFBTbmk3NWw0SzVNY3NkYzJCK3gK",
      "endpoints": [
        "https://github.com/data-tuna/nts-desktop-winamp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
