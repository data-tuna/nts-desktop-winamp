{
  "name": "nts-desktop-winamp",
  "private": true,
  "version": "0.1.2",
  "description": "Unofficial Winamp-style desktop player for NTS Radio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
